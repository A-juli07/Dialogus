# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Database (SQLite is default, but you can use PostgreSQL)
# DATABASE_URL=postgresql://user:password@postgres:5432/dialogus

# Superuser (created automatically on first run)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@dialogus.com
DJANGO_SUPERUSER_PASSWORD=admin123
